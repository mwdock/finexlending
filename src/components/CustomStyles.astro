---
import '@fontsource-variable/raleway';
import '@fontsource-variable/playfair-display';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Raleway Variable', 'Inter Variable', 'Helvetica Neue', Arial, sans-serif;
    --aw-font-serif: 'Playfair Display Variable', 'Raleway Variable', serif;
    --aw-font-heading: 'Playfair Display Variable', 'Raleway Variable', 'Inter Variable', sans-serif;

    --aw-color-primary: #1f3886;
    --aw-color-secondary: #0e1d60;
    --aw-color-accent: #fcb900;

    --aw-color-text-heading: #0c1224;
    --aw-color-text-default: #1a1f2c;
    --aw-color-text-page: #1a1f2c;
    --aw-color-text-muted: rgba(12, 18, 36, 0.72);
    --aw-color-bg-page: #f7f8fc;

    --aw-color-bg-page-dark: #050816;

    ::selection {
      background-color: rgba(31, 56, 134, 0.25);
      color: #0e1d60;
    }
  }

  .dark {
    --aw-font-sans: 'Raleway Variable', 'Inter Variable', 'Helvetica Neue', Arial, sans-serif;
    --aw-font-serif: 'Playfair Display Variable', 'Raleway Variable', serif;
    --aw-font-heading: 'Playfair Display Variable', 'Raleway Variable', 'Inter Variable', sans-serif;

    --aw-color-primary: #9db7ff;
    --aw-color-secondary: #6e84d6;
    --aw-color-accent: #ffd77a;

    --aw-color-text-heading: #f8fafc;
    --aw-color-text-default: rgba(248, 250, 252, 0.92);
    --aw-color-text-page: rgba(248, 250, 252, 0.92);
    --aw-color-text-muted: rgba(248, 250, 252, 0.65);
    --aw-color-bg-page: #050816;

    ::selection {
      background-color: rgba(255, 215, 122, 0.35);
      color: #050816;
    }
  }
</style>
