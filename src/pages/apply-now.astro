---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';

const metadata = {
  title: 'Apply Now',
  description: 'Start your Verico Finex Lending mortgage application with a secure intake form.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm uppercase tracking-widest text-secondary font-semibold mb-3">Apply Now</p>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">Start Your Application</h1>
      <p class="text-lg text-muted mb-10">
        Embed your secure intake form or link to your preferred application portal here. The space below is ready for
        custom fields, disclosures, and next steps when you are.
      </p>
      <div class="rounded-2xl border border-dashed border-gray-300 dark:border-gray-600 bg-white/40 dark:bg-white/5 p-6 md:p-10 mb-6">
        <p class="text-base text-muted mb-4">Replace this placeholder with your application form.</p>
        <Button text="Download Application PDF" variant="secondary" href="#" />
      </div>
      <div class="bg-primary/5 border border-primary/20 rounded-2xl p-6">
        <p class="text-sm text-primary uppercase tracking-widest font-semibold mb-2">Need Assistance?</p>
        <p class="text-base text-gray-900 dark:text-white">
          Add contact instructions, document checklists, or scheduling links so applicants know how to reach you.
        </p>
      </div>
    </div>
  </section>
</Layout>
