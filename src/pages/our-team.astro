---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Our Team',
  description: 'Meet the advisors, underwriters, and client experience specialists behind Verico Finex Lending.',
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm uppercase tracking-widest text-secondary font-semibold mb-3">People First</p>
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">Our Team</h1>
      <p class="text-lg text-muted mb-10">
        Introduce your leadership group, mortgage agents, and support specialists here. Replace this placeholder content
        with bios, credentials, headshots, and the story behind your client experience model.
      </p>
      <div class="rounded-2xl border border-dashed border-gray-300 dark:border-gray-600 bg-white/40 dark:bg-white/5 p-6 md:p-10">
        <p class="text-base text-muted">
          Drop your team grid or individual profiles into this block to bring the Finex Lending story to life.
        </p>
      </div>
    </div>
  </section>
</Layout>
